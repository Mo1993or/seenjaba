{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "seenjaba": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/seenjaba",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "tsconfig.app.json",
            "assets": ["src/favicon.svg", "src/assets"],
            "styles": ["src/styles.css"]
          },
          "configurations": {
            "production": {
              "budgets": [{"type":"initial","maximumWarning":"1.5mb","maximumError":"2mb"}],
              "outputHashing": "all"
            },
            "development": {"optimization": false, "extractLicenses": false, "sourceMap": true}
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": {"buildTarget":"seenjaba:build:production"},
            "development": {"buildTarget":"seenjaba:build:development"}
          },
          "defaultConfiguration":"development"
        }
      }
    }
  },
  "cli": {
    "analytics": "8a0d8405-bfd0-4104-8e21-4f159e7acb03"
  }
}
